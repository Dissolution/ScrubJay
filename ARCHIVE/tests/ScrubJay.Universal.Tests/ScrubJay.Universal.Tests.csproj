<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net9.0;net8.0;net48;</TargetFrameworks>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <NoWarn>$(NoWarn);CA2201;CA1515;RS0016;RS0037;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2"/>
        <PackageReference Include="Polyfill" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\ScrubJay.Errors\ScrubJay.Errors.csproj" />
      <ProjectReference Include="..\..\src\ScrubJay.Testing\ScrubJay.Testing.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\..\src\ScrubJay.Universal\ScrubJay.Universal.csproj" />
    </ItemGroup>

</Project>