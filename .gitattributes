# Auto detect text files and perform LF normalization
* text=auto

# csharp
*.cs      text diff=csharp eol=crlf
*.slnx    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Scripts expect certain line endings
*.sh      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary files
*.ico     binary
*.png     binary
