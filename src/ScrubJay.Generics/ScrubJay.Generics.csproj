<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;net7.0;net6.0;net5.0;netstandard2.1;netstandard2.0;</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="ScrubJay.Generics.Extensions"/>
    </ItemGroup>

    <!-- NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="Fody" PrivateAssets="all"/>
        <PackageReference Include="InlineIL.Fody" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Reflection.Emit" PrivateAssets="all"/>
        <PackageReference Include="System.Reflection.Emit.Lightweight" PrivateAssets="all"/>
        <PackageReference Include="Nullable" PrivateAssets="all"/>
    </ItemGroup>

</Project>