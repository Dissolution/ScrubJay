<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>ScrubJay</AssemblyName>
        <RootNamespace>ScrubJay</RootNamespace>

        <!--        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;net7.0;net6.0;net5.0;netstandard2.1;netstandard2.0;</TargetFrameworks>-->
        <TargetFramework>net11.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ScrubJay.Functional\ScrubJay.Functional.csproj"/>
        <ProjectReference Include="..\ScrubJay.Generics\ScrubJay.Generics.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Polyfill"/>
        <PackageReference Include="Fody" PrivateAssets="all"/>
        <PackageReference Include="InlineIL.Fody" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="ScrubJay.Generics"/>
        <Using Include="ScrubJay.Functional"/>
        <Using Include="ScrubJay.Functional.Extensions"/>
        <Using Include="ScrubJay.Extensions"/>
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="Memory\ARCHIVE\ScrubJay.Memory.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <PolyNullability>true</PolyNullability>
        <PolyPublic>true</PolyPublic>
    </PropertyGroup>

</Project>