<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;netstandard2.1;netstandard2.0;net48;</TargetFrameworks> -->
        <!-- <LangVersion>latest</LangVersion> -->
        
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>preview</LangVersion>

        <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
    </PropertyGroup>

    <!-- NuGet -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ScrubJay.Functional</PackageId>
        <Title>ScrubJay - Functional</Title>
        <Description>
            Functional types and extensions for C#.
        </Description>
        <Version>0.91.0-alpha</Version>
    </PropertyGroup>

    <!-- Global Usings -->
    <ItemGroup>
        <Using Include="ScrubJay.Functional.Prelude" Static="True"/>
    </ItemGroup>
</Project>
