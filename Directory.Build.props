	<!-- 32/64 -->
	<PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(PlatformTarget)' == 'x64'">
		<DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
	</PropertyGroup>
