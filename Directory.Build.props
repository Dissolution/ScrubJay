<Project>

    <!-- Common to all Projects -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Deterministic>true</Deterministic>
        <!-- CS8981; -->
        <!-- CS1591; -->
        <!-- CA1303; Do not pass literals as localized parameters -->
        <!-- CA1051; Do not declare visible instance fields -->
        <NoWarn>$(NoWarn);CS8981;CS1591;CA1303;CA1051;</NoWarn>
        
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CA0022;</NoWarn>
    </PropertyGroup>

    <!-- NuGet common to all Projects -->
    <PropertyGroup>
        <Authors>Dissolution</Authors>
        <RepositoryUrl>https://github.com/Dissolution/ScrubJay</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <!-- Global Usings -->
    <ItemGroup>
        <Using Include="Polyfills"/>
        <Using Include="JetBrains.Annotations"/>
        <Using Include="System.Collections"/>
        <Using Include="System.Diagnostics"/>
        <Using Include="System.Diagnostics.CodeAnalysis"/>
        <Using Include="System.Numerics"/>
        <Using Include="System.Runtime.CompilerServices"/>
        <Using Include="System.Runtime.InteropServices"/>
        <Using Include="System.Text"/>
        <!-- Global Aliases -->
        <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="text"/>
        <Using Include="System.Diagnostics.CodeAnalysis.NotNullAttribute" Alias="NotNullAttribute"/>
    </ItemGroup>

    <ItemGroup>
        <!-- All Projects reference JetBrains.Annotations -->
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
        <!-- All Projecte reference Blokyk's Value Not Used Suppressor -->
        <PackageReference Include="Blokyk.Roslyn.ValueNotUsedSuppressor" PrivateAssets="all"/>

        <!-- Net Framework and Net Standard include System.Memory -->
        <PackageReference Condition="$(TargetFrameworkIdentifier) == '.NETStandard' or 
                                     $(TargetFrameworkIdentifier) == '.NETFramework'"
                          Include="System.Memory"/>
    </ItemGroup>

    <!-- Build Configurations -->

    <!-- Debug is quiet, for rapid debugging -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>$(DefineConstants);DEBUG;TRACE;</DefineConstants>
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
    </PropertyGroup>

    <!-- Analyze will run all of the analyzers -->
    <PropertyGroup Condition="'$(Configuration)' == 'Analyze'">
        <DefineConstants>$(DefineConstants);DEBUG;ANALYZE;</DefineConstants>
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <WarningLevel>13</WarningLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisMode>All</AnalysisMode>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <ReportAnalyzer>true</ReportAnalyzer>
    </PropertyGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Analyze'">
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <!--        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">-->
        <!--            <PrivateAssets>all</PrivateAssets>-->
        <!--            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>-->
        <!--        </PackageReference>-->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Formatting.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <!--        <PackageReference Include="Meziantou.Analyzer">-->
        <!--            <PrivateAssets>all</PrivateAssets>-->
        <!--            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>-->
        <!--        </PackageReference>-->
        <!--        <PackageReference Include="StyleCop.Analyzers">-->
        <!--            <PrivateAssets>all</PrivateAssets>-->
        <!--            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>-->
        <!--        </PackageReference>-->
        <!--        <PackageReference Include="SonarAnalyzer.CSharp">-->
        <!--            <PrivateAssets>all</PrivateAssets>-->
        <!--            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>-->
        <!--        </PackageReference>-->
        <!--        <PackageReference Include="SonarAnalyzer.CSharp.Styling">-->
        <!--            <PrivateAssets>all</PrivateAssets>-->
        <!--            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>-->
        <!--        </PackageReference>-->
        <PackageReference Include="AsyncFixer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <!--        <AdditionalFiles Include="BannedSymbols.txt" Visible="false"/> &lt;!&ndash; used by BannedAPiAnalyzers &ndash;&gt;-->
        <PackageReference Include="xunit.analyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Release and NuGet -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Nuget'">
        <DefineConstants>$(DefineConstants);RELEASE;</DefineConstants>
        <Optimize>true</Optimize>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Nuget'">
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Nuget Generation -->
    <PropertyGroup Condition="'$(Configuration)' == 'Nuget'">
        <DefineConstants>$(DefineConstants);NUGET;</DefineConstants>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnablePackageValidation>false</EnablePackageValidation>
        <PackageOutputPath>..\..\packages\</PackageOutputPath>
    </PropertyGroup>

    <!-- Special conditions -->
    <PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(PlatformTarget)' == 'x64'">
        <DefineConstants>$(DefineConstants);TARGET_64BIT;</DefineConstants>
    </PropertyGroup>
</Project>