<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Ignore old versions -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- I'm okay with the global using aliases being lowercase -->
    <NoWarn>$(NoWarn);CS8981;</NoWarn>
  </PropertyGroup>

  <!-- Code analysis -->
  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningLevel>9999</WarningLevel>
    <WarningsAsErrors>$(WarningsAsErrors);CS8600;CS8602;CS8603;</WarningsAsErrors>
  </PropertyGroup>

  <!-- global packages -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
    <PackageReference Condition="$(TargetFrameworkIdentifier) == '.NETStandard' or
                                 $(TargetFrameworkIdentifier) == '.NETFramework'"
                      Include="System.Memory"/>
    <PackageReference Condition="$(TargetFramework) == 'netstandard2.1'"
                      Include="System.Runtime.CompilerServices.Unsafe"
                      PrivateAssets="all"/>
  </ItemGroup>

  <!-- CodeMetrics needed for .editorconfig -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt"/>
  </ItemGroup>

  <!-- global usings -->
  <ItemGroup>
    <Using Include="JetBrains.Annotations"/>

    <Using Include="System.Collections"/>
    <Using Include="System.Diagnostics"/>
    <Using Include="System.Diagnostics.CodeAnalysis"/>
    <Using Include="System.Runtime.CompilerServices"/>
    <Using Include="System.Runtime.InteropServices"/>
    <Using Include="System.Text"/>
    <Using Include="System.Numerics"/>

    <!-- Aliases -->
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="text"/>
    <Using Include="System.ReadOnlySpan&lt;System.Byte&gt;" Alias="bytesview"/>
    <Using Include="System.Span&lt;System.Byte&gt;" Alias="bytes"/>
    <Using Include="System.Diagnostics.CodeAnalysis.NotNullAttribute" Alias="NotNullAttribute"/>
  </ItemGroup>
</Project>
