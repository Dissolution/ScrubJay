<Project>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Features>strict</Features>
		<!-- Individual suppressions are located in `.editorconfig` -->
		<NoWarn>$(NoWarn);CS1591;</NoWarn>
		<ErrorReport>prompt</ErrorReport>
	</PropertyGroup>
	<!-- Build Configurations -->
	<PropertyGroup Condition="'$(BuildType)' == 'Debug' Or '$(BuildType)' == 'Analyze'">
		<Optimize>false</Optimize>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(BuildType)' == 'Debug'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(BuildType)' == 'Analyze'">
		<DefineConstants>DEBUG;ANALYZE</DefineConstants>
		<AnalysisMode>All</AnalysisMode>
		<AnalysisLevel>latest</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<ReportAnalyzer>true</ReportAnalyzer>
		<Deterministic>true</Deterministic>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AnalysisLevel>latest</AnalysisLevel>
		<WarningLevel>4</WarningLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>
	<PropertyGroup Condition="'$(BuildType)' == 'Release' Or '$(BuildType)' == 'Nuget'">
		<Optimize>true</Optimize>
		<!-- generate XML documentation files -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup Condition="'$(BuildType)' == 'Release' Or '$(BuildType)' == 'Nuget'">
		<None Include="..\README.md" Pack="true" PackagePath="\"/>
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\"/>
	</ItemGroup>
	<PropertyGroup Condition="'$(BuildType)' == 'Release'">
		<DefineConstants>RELEASE;</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(BuildType)' == 'Nuget'">
		<DefineConstants>RELEASE;NUGET</DefineConstants>
		<!-- Create NuGet Package -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- Validate -->
		<EnablePackageValidation>false</EnablePackageValidation>
		<!-- Set common output path for Packages -->
		<PackageOutputPath>..\..\packages\</PackageOutputPath>
	</PropertyGroup>
	<!-- global usings -->
	<ItemGroup>
		<Using Include="JetBrains.Annotations"/>
		<Using Include="System.Collections"/>
		<Using Include="System.Diagnostics"/>
		<Using Include="System.Diagnostics.CodeAnalysis"/>
		<Using Include="System.Numerics"/>
		<Using Include="System.Runtime.CompilerServices"/>
		<Using Include="System.Runtime.InteropServices"/>
		<Using Include="System.Text"/>
		<!-- Aliases -->
		<Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="text"/>
		<Using Include="System.Diagnostics.CodeAnalysis.NotNullAttribute" Alias="NotNullAttribute"/>
	</ItemGroup>
	<!-- global attributes -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>ScrubJay.Sandboxes.Console</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<!-- My Nuget Info -->
	<PropertyGroup>
		<Authors>Dissolution</Authors>
		<RepositoryUrl>https://github.com/Dissolution/ScrubJay</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>
	
	<!-- Nuget Packages -->
	<!-- Common -->
	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<!-- Analyzers -->
	<ItemGroup Condition="'$(BuildType)' == 'Analyze'">
