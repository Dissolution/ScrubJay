<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ScrubJay.Reflection</RootNamespace>
        <AssemblyName>ScrubJay.Reflection</AssemblyName>

        <!-- Always supports the latest versions -->
        <!-- https://learn.microsoft.com/en-us/dotnet/standard/frameworks#latest-version -->
        <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;netstandard2.1;netstandard2.0;net48;</TargetFrameworks>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.Reflection"/>
        <Using Include="System.Reflection.Emit"/>

        <Using Include="ScrubJay.Functional.Prelude" Static="true"/>
        <Using Include="ScrubJay.Functional"/>
        <Using Include="ScrubJay.Extensions"/>
        <Using Include="ScrubJay.Text"/>
        <Using Include="ScrubJay.Text.Building"/>
        <Using Include="ScrubJay.Reflection.Extensions"/>
        <Using Include="ScrubJay.Validation"/>
        <Using Include="ScrubJay.Comparison"/>
        <Using Include="ScrubJay.Memory"/>
        <Using Include="ScrubJay.Parsing"/>
        <Using Include="ScrubJay.Rendering"/>
    </ItemGroup>

    <!-- NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="Fody">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="InlineIL.Fody">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    </ItemGroup>

    <!-- .NetStandard and .NetFramework require extra packages -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net481' Or '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Memory"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
        <PackageReference Include="System.Reflection.Emit">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="System.Reflection.Emit.Lightweight">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ScrubJay.Core\src\ScrubJay.Core.csproj"/>
        <ProjectReference Include="..\..\ScrubJay.Functional\src\ScrubJay.Functional.csproj"/>
        <ProjectReference Include="..\..\ScrubJay.Universal\src\ScrubJay.Universal.csproj"/>
    </ItemGroup>
</Project>
