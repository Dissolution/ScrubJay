<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        
        <!-- Disable warnings -->
        <NoWarn>
            $(NoWarn);
            IDE0058;    <!-- Expression Value is Never Used - conflicts with Assert -->
            CA2201;     <!-- Exception type System.Exception is fine for testing -->
        </NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\core\ScrubJay.Functional.csproj"/>
    </ItemGroup>

</Project>
