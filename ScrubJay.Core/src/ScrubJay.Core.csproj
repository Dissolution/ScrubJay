<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ScrubJay</RootNamespace>
        <AssemblyName>ScrubJay</AssemblyName>

        <!-- Always supports the latest versions -->
        <!-- https://learn.microsoft.com/en-us/dotnet/standard/frameworks#latest-version -->
        <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;netstandard2.1;netstandard2.0;net48</TargetFrameworks>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <NoWarn>$(NoWarn);CS1591;</NoWarn>

        <!-- Ensure that all Polyfilled types are public -->
        <PolyPublic>true</PolyPublic>
        <PolyStringInterpolation>true</PolyStringInterpolation>
    </PropertyGroup>


    <!-- NuGet -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ScrubJay.Core</PackageId>
        <Title>ScrubJay - Core</Title>
        <Description>
            The core ScrubJay library: common code used in all ScrubJay solutions.
        </Description>
        <Version>0.91.0-alpha</Version>
    </PropertyGroup>

    <!-- Expose our internals to Benchmarks, Test, and downstream ScrubJay libraries -->
    <ItemGroup>
        <InternalsVisibleTo Include="ScrubJay.Benchmarks"/>
        <InternalsVisibleTo Include="ScrubJay.Tests"/>

        <InternalsVisibleTo Include="ScrubJay.Reflection"/>
        <InternalsVisibleTo Include="ScrubJay.Reflection.Scratch"/>
    </ItemGroup>

    <!-- Global Usings -->
    <ItemGroup>
      
        <Using Include="System.ComponentModel"/>

        <Using Include="ScrubJay.Functional.Prelude" Static="true"/>
        <Using Include="ScrubJay.Prelude" Static="true"/>
        <Using Include="ScrubJay.Universal"/>

        <Using Include="ScrubJay.Collections"/>
        <Using Include="ScrubJay.Collections.Pooling"/>
        <Using Include="ScrubJay.Comparison"/>
        <Using Include="ScrubJay.Enums"/>
        <Using Include="ScrubJay.Extensions"/>
        <Using Include="ScrubJay.Functional"/>
        <Using Include="ScrubJay.Memory"/>
        <Using Include="ScrubJay.Text"/>
        <Using Include="ScrubJay.Text.Building"/>
        <Using Include="ScrubJay.Utilities"/>
        <Using Include="ScrubJay.Validation"/>
    </ItemGroup>

    <!-- NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="Fody">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="InlineIL.Fody">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Polyfill">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- .NetStandard and .NetFramework require extra packages -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net481' Or '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Memory"/>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
        <PackageReference Include="System.Reflection.Emit.Lightweight">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ScrubJay.Functional\src\ScrubJay.Functional.csproj"/>
        <ProjectReference Include="..\..\ScrubJay.Universal\src\ScrubJay.Universal.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="..\..\..\..\Users\Timothy\.nuget\packages\polyfill\9.9.0\contentFiles\cs\netstandard2.1\Trimming\DynamicDependencyAttribute.cs" />
      <Compile Remove="..\..\..\..\Users\Timothy\.nuget\packages\polyfill\9.9.0\contentFiles\cs\netstandard2.0\Trimming\DynamicDependencyAttribute.cs" />
    </ItemGroup>


    <UsingTask TaskName="GenerateValidateFilesTask" AssemblyFile="$(MSBuildProjectDirectory)\..\build_tasks\bin\$(Configuration)\netstandard2.0\BuildTasks.dll"/>

    <Target Name="GenerateValidateFiles" BeforeTargets="BeforeBuild">
        <ItemGroup>
            <GuardFiles Include="**\Guard*.cs" Exclude="bin\**;obj\**;**\Validate*.cs"/>
        </ItemGroup>

        <GenerateValidateFilesTask SourceFiles="@(GuardFiles)"/>
    </Target>
</Project>