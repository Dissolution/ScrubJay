<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;netstandard2.1;netstandard2.0;net48;</TargetFrameworks>
    </PropertyGroup>

    <!-- NuGet -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ScrubJay.Universal</PackageId>
        <Title>ScrubJay - Universal</Title>
        <Description>
            Provides several utility classes for working with any generic type, even with the `ref struct` anti-constraint.
        </Description>
        <Version>1.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Fody">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="InlineIL.Fody">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Condition="$(TargetFrameworkIdentifier) == '.NETStandard' or $(TargetFrameworkIdentifier) == '.NETFramework'"
                          Include="System.Memory"/>
        <PackageReference Condition="$(TargetFramework) == 'netstandard2.1' "
                          Include="System.Runtime.CompilerServices.Unsafe">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Expose our internals to Tests and Benchmarks -->
    <ItemGroup>
        <InternalsVisibleTo Include="ScrubJay.Universal.Tests"/>
        <InternalsVisibleTo Include="ScrubJay.Universal.Benchmarks"/>

    </ItemGroup>
</Project>
