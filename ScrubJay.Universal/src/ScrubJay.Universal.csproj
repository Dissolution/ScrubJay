<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;netstandard2.1;netstandard2.0;net48;</TargetFrameworks>
        <LangVersion>latest</LangVersion>

        <!-- Expose all the polyfills to consuming projects -->
        <PolyPublic>true</PolyPublic>
        <!-- Adds Interpolation features from Polyfill -->
        <PolyStringInterpolation>true</PolyStringInterpolation>
        <!-- Add Nullability features from Polyfill -->
        <PolyNullability>true</PolyNullability>
    </PropertyGroup>

    <!-- NuGet -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ScrubJay.Universal</PackageId>
        <Title>ScrubJay - Universal</Title>
        <Description>Provides utility classes for working with _Any_ generic value, even if the type has the `allows ref struct` anti-constraint.</Description>
        <Version>2.0.0</Version>
    </PropertyGroup>

    <!-- Global Usings -->
    <ItemGroup>
        <Using Include="InlineIL.IL" Static="true"/>
        <Using Include="InlineIL"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fody" PrivateAssets="all"/>
        <PackageReference Include="InlineIL.Fody" PrivateAssets="all"/>

        <PackageReference Condition="'$(TargetFramework)' == 'netstandard2.0'"
                          Include="System.Reflection.Emit.Lightweight">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Condition="$(TargetFramework) == 'netstandard2.1' "
                          Include="System.Runtime.CompilerServices.Unsafe">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        
        <PackageReference Include="Polyfill" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Expose our internals -->
    <ItemGroup>
        <InternalsVisibleTo Include="ScrubJay.Universal.Tests"/>
        <InternalsVisibleTo Include="ScrubJay.Text"/>
        <InternalsVisibleTo Include="ScrubJay.Text.Tests"/>
        <InternalsVisibleTo Include="ScrubJay.Sandboxes.Console"/>
        <InternalsVisibleTo Include="ScrubJay.Functional"/>
        <InternalsVisibleTo Include="ScrubJay.Functional.Json"/>
        <InternalsVisibleTo Include="ScrubJay.Functional.Tests"/>
        <InternalsVisibleTo Include="ScrubJay.Memory"/>
        <InternalsVisibleTo Include="ScrubJay.Errors"/>
        <InternalsVisibleTo Include="ScrubJay.Errors.Asp"/>
        <InternalsVisibleTo Include="ScrubJay.Enums"/>
        <InternalsVisibleTo Include="ScrubJay.Enums.SourceGen"/>
        <InternalsVisibleTo Include="ScrubJay.Enums.Tests"/>
        <InternalsVisibleTo Include="ScrubJay.Reflection"/>
        <InternalsVisibleTo Include="ScrubJay.Reflection.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\README.md">
            <Link>README.md</Link>
        </Content>
    </ItemGroup>
</Project>
