dotnet_diagnostic.IDE0251.severity = suggestion
csharp_style_prefer_readonly_struct_member = true:suggestion

# IDE0260 -> IDE0078

# IDE0270 -> IDE0029

# IDE0280 - Use 'nameof'
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0280
