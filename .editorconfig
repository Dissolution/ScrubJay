# IDE0301 - Use collection expression for empty
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0301
dotnet_diagnostic.IDE0301.severity = error

# IDE0302 - Use collection expression for stackalloc
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0302
dotnet_diagnostic.IDE0302.severity = none

# IDE0303 - Use collection expression for `Create()`
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0303
dotnet_diagnostic.IDE0303.severity = suggestion

# IDE0304 - Use collection expression for builder
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0304
dotnet_diagnostic.IDE0304.severity = suggestion

# IDE0305 - Use collection expression for fluent
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0305
dotnet_diagnostic.IDE0305.severity = suggestion

# IDE0306 - Use collection expression for `new`
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0306
dotnet_diagnostic.IDE0306.severity = suggestion

# IDE0320 - Make anonymous function static
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0320
dotnet_diagnostic.IDE0320.severity = error
csharp_prefer_static_anonymous_function = true:error

# IDE0330 - Prefer 'System.Threading.Lock'
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0330
dotnet_diagnostic.IDE0330.severity = error
csharp_prefer_system_threading_lock = true:error

# IDE0340 - Use unbound generic type
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0340
dotnet_diagnostic.IDE0340.severity = error
csharp_style_prefer_unbound_generic_type_in_nameof = true:error

# IDE0350 - Use implicitly typed lambda
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0350
dotnet_diagnostic.IDE0350.severity = warning
csharp_style_prefer_implicitly_typed_lambda_expression = true:warning

# IDE0360 - Simplify property accessor
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0360
dotnet_diagnostic.IDE0360.severity = suggestion
csharp_style_prefer_simple_property_accessors = true:suggestion

# IDE0370 - Remove unnecessary suppression
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0370
dotnet_diagnostic.IDE0370.severity = warning

# IDE0380 - Remove unnecessary `unsafe` modifier
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0380
dotnet_diagnostic.IDE0380.severity = warning

# IDE0390
# IDE0391 - Make method synchronous
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0390-ide0391
dotnet_diagnostic.IDE0390.severity = suggestion
dotnet_diagnostic.IDE0391.severity = suggestion

# IDE0410 - Simplify property accessor
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0410
dotnet_diagnostic.IDE0410.severity = warning
csharp_style_prefer_labeled_jump_statements = true:warning

# IDE1005 - Use conditional delegate call
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide1005
dotnet_diagnostic.IDE1005.severity = error
csharp_style_conditional_delegate_call = true:error

# IDE1007 - The name does not exist in the current context
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide1007
# dotnet_diagnostic.IDE1007.severity = warning
# This is used for internal diagnostics

# IDE2000 - Avoid multiple blank lines
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2000
dotnet_diagnostic.IDE2000.severity = suggestion
dotnet_style_allow_multiple_blank_lines_experimental = false:suggestion

# IDE2001 - Embedded statements must be on their own line
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2001
dotnet_diagnostic.IDE2001.severity = error
csharp_style_allow_embedded_statements_on_same_line_experimental = false:error

# IDE2002 - Consecutive braces must not have blank line between them
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2002
dotnet_diagnostic.IDE2002.severity = error
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false:error

# IDE2003 - Blank line required between block and subsequent statement
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2003
dotnet_diagnostic.IDE2003.severity = suggestion
dotnet_style_allow_statement_immediately_after_block_experimental = false:suggestion

# IDE2004 - Blank line not allowed after constructor initializer colon
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2004
dotnet_diagnostic.IDE2004.severity = suggestion
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = true:suggestion

# IDE2005 - Blank line not allowed after conditional expression token
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2005
dotnet_diagnostic.IDE2005.severity = warning
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false:warning

# IDE2006 - Blank line not allowed after conditional expression token
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide2006
dotnet_diagnostic.IDE2006.severity = error
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = false:error


###
# Miscellaneous rules
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/miscellaneous-rules


# IDE0076 - Remove invalid global 'SuppressMessageAttribute'
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0076
dotnet_diagnostic.IDE0076.severity = error

# IDE0077 - Avoid legacy format target in global 'SuppressMessageAttribute'
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0077
dotnet_diagnostic.IDE0077.severity = error

# IDE3000 - Implement with Copilot
